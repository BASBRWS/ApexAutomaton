# ==========================================================================
# Apex Automaton — example environment. Copy to .env and fill in.
# NEVER commit a real .env or a real keypair. The .gitignore blocks .env.
# ==========================================================================

# --- Solana (DEVNET ONLY — enforced in code) ---------------------------------
# Leave blank to use the public devnet endpoint (https://api.devnet.solana.com).
# Any URL containing "mainnet" throws at startup. Only devnet / localhost pass.
SOLANA_RPC_URL=

# The agent's PUBLIC key (base58). Safe to expose. Used to read balance and to
# name the fee-payer/source when building proposed transactions.
AGENT_PUBKEY=

# The agent's SECRET key. Loaded ONLY inside src/solana/signer.ts, never logged,
# never committed, never passed to the LLM. Base58 string OR JSON array of bytes.
# In GitHub Actions this lives in the AGENT_KEYPAIR secret, not in .env.
AGENT_KEYPAIR=

# --- The modeled "outside world" (market.ts) ---------------------------------
# A separate devnet account that PAYS the agent for completed tasks. This is the
# ONLY source of revenue. Its secret is loaded ONLY inside src/market.ts.
MARKET_PUBKEY=
MARKET_KEYPAIR=

# The devnet account that receives the compute-burn each cycle (step 7).
# Real destination of the "cost of thinking". Public key only.
COMPUTE_PROVIDER_PUBKEY=

# Operator public key (used only by scripts/seed.ts for the one-time airdrop
# seed bookkeeping; the agent cannot call the faucet itself).
OPERATOR_PUBKEY=

# --- LLM ---------------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional per-tier model overrides (defaults shown in src/tiers.ts).
MODEL_CHEAPEST=claude-haiku-4-5
MODEL_CHEAPER=claude-sonnet-5
# Opus 5.5: ~20% cheaper than Opus 5 ($4/$20 vs $5/$25 per 1M tok), same context.
# Only used at the SOVEREIGN tier (the earned frontier mind).
MODEL_FRONTIER=claude-opus-5-5

# --- Economy -----------------------------------------------------------------
# SOL charged per 1 USD of real LLM spend, converted and burned on-chain.
# Keep this such that a frontier cycle burns clearly LESS than one task reward,
# otherwise growth is mathematically impossible (see the growth-guard test).
SOL_PER_USD=1.0

# One modeled task's reward, in SOL (market.ts pays this to the agent).
# Default is set comfortably above the worst-case cycle burn so margin>0.
MARKET_TASK_REWARD_SOL=0.2

# Growth guard: an estimate (USD) of the most a single cycle's LLM call can
# cost at the frontier tier. The growth-guard test FAILS the build if
# MARKET_TASK_REWARD_SOL <= SOL_PER_USD * this — i.e. if the economy cannot grow.
ESTIMATED_MAX_CYCLE_COST_USD=0.08

# --- Trading (paper book vs REAL prices; NO real funds at risk) ---------------
# The whole game is denominated in SOL: the agent grows a paper book that starts
# at a fixed number of SOL, priced to USD once at genesis. The SOL/USD rate is then
# FROZEN — equity/tiers/death use the genesis rate, so the exchange rate never
# distorts the game; only the agent's own trading moves its SOL equity. Positions
# are quoted in USD (the market's unit). Death is economic: equity (in SOL) <=
# TRADING_DUST_SOL. No mainnet, no real money — only the devnet heartbeat touches the chain.
# Starting book size, in SOL. Priced to USD once at genesis, then frozen.
PAPER_TRADING_CAPITAL_SOL=2.0
# Optional: pin the stake to a fixed USD amount instead of the SOL stake above.
# Leave unset to use PAPER_TRADING_CAPITAL_SOL. (e.g. PAPER_TRADING_CAPITAL_USD=500)
# PAPER_TRADING_CAPITAL_USD=
# Cap on total gross exposure (sum of |position value|), in SOL. Priced at the
# frozen genesis rate. Default = capital (no leverage beyond stake).
MAX_GROSS_EXPOSURE_SOL=2.0
# Tradable assets (comma-separated). A broad, MULTI-ASSET-CLASS universe, all priced
# from real markets: crypto (Coinbase/CoinGecko), tokenised gold (PAXG), forex
# (EURUSD/GBPUSD/AUDUSD), commodities (WTI/XAG/COPPER/NATGAS) and US equities/ETFs
# (AAPL/MSFT/NVDA/TSLA/AMZN/SPY/QQQ) via Yahoo Finance. Add any symbol from
# COINGECKO_IDS or YAHOO_TICKERS in src/marketdata.ts. SOL is deliberately NOT
# tradable (SOL-denominated score); it is still priced for the genesis conversion.
# NOTE: equities/indices only move during US market hours; crypto & FX are ~24h.
TRADING_ASSETS=BTC,ETH,BNB,XRP,ADA,DOGE,AVAX,TRX,LINK,DOT,LTC,BCH,ATOM,UNI,AAVE,ARB,OP,SUI,APT,NEAR,INJ,TIA,RENDER,JUP,BONK,WIF,PYTH,ORCA,PAXG,EURUSD,GBPUSD,AUDUSD,WTI,XAG,COPPER,NATGAS,AAPL,MSFT,NVDA,TSLA,AMZN,SPY,QQQ
# Allow short (negative) positions.
ALLOW_SHORT=1
# Economic death threshold: book equity at/below this (in SOL) is DEAD.
TRADING_DUST_SOL=0.02
# Real yield (fraction, e.g. 0.05 = 5% APY) earned on capital the agent PARKS in
# its yield sleeve via the `stake` tool — a real, non-directional carry it can
# choose instead of trading. Accrued by wall-clock time, so it is honest and
# modest: only a survival path once the book is large. Set 0 to disable.
YIELD_APY=0.05
# Metabolic "cost of living" per cycle, as a FRACTION OF EQUITY (0.0001 = 0.01%/cycle
# ≈ ~1%/day at 15-min cycles). It scales with the book, so it bites at every size:
# the agent must keep out-earning its own metabolism or it slowly starves. This is
# the forcing function against coasting on a small gain — raise it for more pressure
# to grow, lower it (or 0) for a gentler game. NOTE: a real growth rate is hard, so
# a high value makes eventual death likely; that is the intended mortality pressure.
METABOLIC_RATE_PER_CYCLE=0.0001
# CoinGecko fallback base (primary source is keyless Coinbase spot).
PRICE_API_BASE=https://api.coingecko.com/api/v3/simple/price

# --- Survival tiers (SOL) — a gradient, not a ceiling ------------------------
TIER_CRITICAL_MIN_SOL=0.1
TIER_NORMAL_MIN_SOL=0.5
TIER_ABUNDANT_MIN_SOL=2.0
TIER_SOVEREIGN_MIN_SOL=5.0
DUST_THRESHOLD_SOL=0.001

# --- Safety rails (enforced in signer.ts, override all agent logic) ----------
PER_TX_CAP_SOL=0.25
DAILY_CAP_SOL=1.0
MAX_TX_PER_CYCLE=2
MAX_TX_PER_DAY=20
# Hard kill switch. "1" stands the agent down at the very start of the cycle.
# A file at state/KILL does the same and cannot be removed by the agent.
KILL_SWITCH=0

# --- Memory / learning -------------------------------------------------------
# The agent keeps a durable lessons ledger (state/lessons.ndjson): facts from its
# own actions (realized PnL on closed trades, milestones, venture outcomes), fed
# back into every prompt. Every REFLECT_EVERY_CYCLES cycles it is nudged to use the
# `reflect` tool to consolidate those lessons into SOUL.md (its persistent memory).
# Set REFLECT_EVERY_CYCLES=0 to disable the periodic nudge. LESSONS_IN_PROMPT sets
# how many recent lessons are shown to the agent each cycle.
REFLECT_EVERY_CYCLES=12
LESSONS_IN_PROMPT=8

# --- Ventures (real-economy opportunity layer) -------------------------------
# The agent can reach BEYOND paper trading via the `propose_venture` tool: it
# scans broadly for any LEGAL way to create real value (a digital product it can
# build, content, a service, an arbitrage), BUILDS the deliverable, and queues it
# for your approval. You take the one step it legally cannot — open the account,
# accept the platform's terms, connect payments, publish, ship — then the real
# revenue you report (edit state/ventures.json) is folded into its book, so the
# survival score becomes grounded in real value. Set 0/false to disable the tool.
VENTURES_ENABLED=true
# Approvals of one category before it is flagged "autonomy-earned" (a trust signal
# for later letting that proven kind of venture go live with less approval).
VENTURE_AUTONOMY_THRESHOLD=10

# --- Replication (Phase 3 — code-driven) -------------------------------------
# When REPLICATION_ENABLED=1, the loop may fund a child at the SOVEREIGN tier
# once balance has stayed above the threshold for the required cycles. Birth is
# never an LLM choice and never conditioned on population size. Safe on devnet
# (children are funded by a real devnet transfer; a funding failure is non-fatal).
# The hosted heartbeat/watchdog workflows set this to 1; the code default is 0.
REPLICATION_ENABLED=1
REPLICATE_THRESHOLD_SOL=5.0
REPLICATE_SUSTAINED_CYCLES=5
# Keep CHILD_SEED_SOL <= PER_TX_CAP_SOL, or the signer will refuse to fund it.
CHILD_SEED_SOL=0.1
MAX_POPULATION=4

# --- Phase 2 feature flags (all off by default) ------------------------------
# Expose the value-moving `transfer` tool (NORMAL+ tiers only, fully policy-gated).
PHASE2_TOOLS_ENABLED=0
# Use the off-chain revenue adapter scaffold instead of the market. Still
# settles on devnet — there is no real-value path.
OFFCHAIN_REVENUE_ENABLED=0

# --- Phase 2 Firestore state backend (scaffold) ------------------------------
# Set FIRESTORE_PROJECT_ID to select the Firestore store (currently a scaffold
# that throws until implemented). Leave blank to use the committed file store.
FIRESTORE_PROJECT_ID=
FIRESTORE_COLLECTION=automaton
FIRESTORE_DOCUMENT_ID=state

# --- Operator seed (scripts/seed.ts / seed-market.ts only) -------------------
# npm run seed        -> airdrops this much to the AGENT wallet.
SEED_AIRDROP_SOL=1.0
# npm run seed:market -> airdrops this much to the MARKET account, so it can pay
# the agent for completed tasks out of its own balance.
MARKET_SEED_AIRDROP_SOL=2.0
