{
  "name": "apex-automaton",
  "version": "0.1.0",
  "private": true,
  "description": "A growth-seeking autonomous agent on Solana devnet. Its objective is to grow its net SOL balance; survival is the floor, not the goal. Mortality engineering at zero financial risk.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "tick": "tsx src/index.ts",
    "tick:dry": "tsx scripts/tick-dry.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:market": "tsx scripts/seed-market.ts",
    "keygen": "tsx scripts/keygen.ts",
    "setup": "tsx scripts/serve.ts setup",
    "dashboard": "tsx scripts/serve.ts dashboard",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@solana/web3.js": "^1.95.4",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
